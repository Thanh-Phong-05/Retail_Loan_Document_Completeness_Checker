                  id="Definitions_Confirm02QCamundaIT" targetNamespace="http://bpmn.io/schema/bpmn"
                  modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.5.0">
  <bpmn:process id="retail-loan-confirm-02q-it" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Confirm02QIT">
      <bpmn:outgoing>Flow_ToConfirm</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_03e0s8k" name="Isolated dossier confirmation">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_ToConfirm</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Confirm02QIT">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToConfirm" sourceRef="StartEvent_Confirm02QIT" targetRef="Activity_03e0s8k" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Activity_03e0s8k" targetRef="EndEvent_Confirm02QIT" />
  </bpmn:process>
</bpmn:definitions>
