    <bpmn:sequenceFlow id="Flow_0gcvgk9" sourceRef="Gateway_1d3m1te" targetRef="Event_17rzuno">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">== overallStatus = "READY_FOR_CREDIT_REVIEW"</bpmn:conditionExpression>
